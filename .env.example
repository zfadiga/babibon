# Configuration Express Backend
PORT=3001

# Configuration Supabase (Base de données PostgreSQL & Stockage)
# Récupère ces clés dans ton projet Supabase : Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Variables d'environnement pour le Frontend Vite (accessibles via import.meta.env)
VITE_API_URL=http://localhost:3001/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
